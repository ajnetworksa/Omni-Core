# OmniCore — copy to .env, fill in what you want, then:  docker compose up -d
# Anything left empty stays off. Every other setting: docs/CONFIGURATION.md

# Your time zone ("today", reminders, the midnight rollover)
TIMEZONE=Asia/Riyadh

# Extras to run, comma-separated:
#   ai           local Ollama; the models below download by themselves on first start
#   quicktunnel  instant https address (…trycloudflare.com) for the Telegram Mini App and phone access;
#                no Cloudflare account needed. The bot sends you the link. It changes if the tunnel restarts.
#   tunnel       Cloudflare Tunnel on your own domain (fill in the token below); the permanent option
#   redis        optional Redis scheduler (the built-in one is fine for one person)
# Example: COMPOSE_PROFILES=ai,quicktunnel
COMPOSE_PROFILES=

# ---------- Telegram (optional) ----------
# Token from @BotFather. Then message your bot: it replies with your user id; put it below.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# ---------- Cloudflare Tunnel (needs "tunnel" in COMPOSE_PROFILES) ----------
# Zero Trust → Networks → Tunnels → create → copy the token. Point its hostname at http://omnicore-app:3000
CLOUDFLARE_TUNNEL_TOKEN=
# The https address you reach the app at; turns on the Telegram Mini App (optional)
PUBLIC_URL=

# ---------- AI (needs "ai" in COMPOSE_PROFILES, or a model server of your own) ----------
AI_CHAT_MODEL=llama3.2:3b
AI_EMBEDDING_MODEL=nomic-embed-text
# Optional: photos → notes (e.g. llama3.2-vision, about 8 GB)
AI_VISION_MODEL=
# Ollama already running on this server instead of the bundled one:
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# ---------- Web password ----------
# Leave empty and one is created for you on first start: read it with  cat data/api-token
API_TOKEN=

# ---------- More (optional; the defaults are fine) ----------
# PORT=3000                      web port on this server
# LISTEN=127.0.0.1               0.0.0.0 = also reachable from other devices on your network (http://<server-ip>:3000)
# DIGEST_TIME=08:00              morning digest (empty = off)
# RETRO_TIME=21:00               evening retro (empty = off)
# NAG_QUIET_HOURS=23:00-07:00    no reminders in these hours
# NAG_INTERVALS=overdue=30,partial=60,remark=120   minutes between reminders
# WEEKEND_DAYS=fri,sat           weekend for "every weekday"
# UPDATE_CHECK_REPO=owner/repo   "update available" notices from GitHub releases
# OMNICORE_IMAGE=ghcr.io/<owner>/<repo>:latest     prebuilt image instead of building here
# CLOUD_MODE=fallback            cloud model when local fails (off by default: nothing leaves this server)
# CLOUD_PROVIDER=anthropic
# CLOUD_API_KEY=
# STT_BASE_URL=                  voice notes → text (any OpenAI-compatible Whisper server)
# PUID=1000                      owner of data/ and vault/ (default: whoever owns vault/)
# PGID=1000
